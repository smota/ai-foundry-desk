{
  "name": "@ai-foundry-desk/cli",
  "version": "0.6.2",
  "private": true,
  "description": "AI Foundry Desk — Multi-Agent Workbench CLI.",
  "type": "module",
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "dev": "tsx src/cli.ts",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  },
  "dependencies": {
    "@profullstack/hqtui": "0.1.9",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  }
}
