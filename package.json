{
  "name": "ai-foundry-desk",
  "version": "0.6.2",
  "description": "AI Foundry Desk — Multi-Agent Workbench for a personal AI workstation.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "afd": "agent-manager/dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "agent-manager/dist",
    "agent-manager/schema",
    "assets/brand",
    "scripts",
    "docs",
    "pilot",
    "recipes",
    "requirements",
    "setup.ps1",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@11.23.0",
  "dependencies": {
    "@profullstack/hqtui": "0.1.9",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "build": "pnpm --filter @ai-foundry-desk/cli build",
    "typecheck": "pnpm --filter @ai-foundry-desk/cli typecheck",
    "lint": "pnpm --filter @ai-foundry-desk/cli lint",
    "test": "pnpm --filter @ai-foundry-desk/cli test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:check",
    "docs:check": "node scripts/check-docs.mjs",
    "afd": "pnpm --filter @ai-foundry-desk/cli dev",
    "afd:status": "pnpm --filter @ai-foundry-desk/cli dev status",
    "afd:review": "pnpm --filter @ai-foundry-desk/cli dev review",
    "afd:sync": "pnpm --filter @ai-foundry-desk/cli dev sync",
    "afd:verify": "pnpm --filter @ai-foundry-desk/cli dev verify",
    "validate:sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/12-validate-agent-environment.ps1 -RequireSandbox",
    "validate:observability": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/14-validate-observability-pilot.ps1",
    "sbom:telemetry": "node scripts/generate-telemetry-sbom.mjs",
    "pack:dry-run": "pnpm build && pnpm pack --dry-run",
    "release:check": "node scripts/check-release-version.mjs",
    "release:build": "node scripts/build-release.mjs"
  }
}
